{
  "name": "@timhettler/radix-layout",
  "version": "0.0.0",
  "description": "Every Layout's layout primitives as Radix-style React components, styled by static CSS.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "module": "./dist/radix-layout.js",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/radix-layout.js"
    },
    "./styles.css": "./dist/styles.css",
    "./defaults.css": "./dist/defaults.css",
    "./stack.css": "./dist/stack.css",
    "./cluster.css": "./dist/cluster.css"
  },
  "license": "MIT",
  "keywords": [
    "ui",
    "react",
    "layout",
    "every-layout",
    "radix"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timhettler/radix-layout.git"
  },
  "scripts": {
    "build": "vite build && node scripts/build-css.mjs",
    "lint": "eslint",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "check:package": "publint && attw --pack --profile esm-only --entrypoints ."
  },
  "dependencies": {
    "@radix-ui/react-primitive": "^2.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.59.4",
    "@timhettler/config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "browserslist": "^4.29.3",
    "browserslist-to-esbuild": "^2.1.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass-embedded": "^1.105.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
