{
  "name": "radix-layout",
  "private": true,
  "workspaces": [
    "config",
    "lib",
    "docs"
  ],
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.8"
  },
  "devDependencies": {
    "@timhettler/config": "workspace:*",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "build": "turbo build",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "turbo run build --filter=@timhettler/radix-layout && changeset publish"
  }
}
