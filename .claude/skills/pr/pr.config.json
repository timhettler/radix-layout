{
  "baseBranch": "main",
  "template": ".github/pull_request_template.md",
  "activate": "source ~/.nvm/nvm.sh && nvm use",
  "planSkill": "tech-plan",
  "worktreeSkill": "worktree",
  "lessons": "docs/lessons",
  "checkBar": "docs/README.md",
  "review": {
    "copilot": null,
    "skipWhenOnly": ["docs/decisions/"],
    "adversarialAgent": "adversarial-reviewer",
    "adversarialWhenAny": [
      ".github/workflows/**",
      ".husky/**",
      "scripts/**",
      "lib/scripts/**",
      "lib/package.json",
      "lib/vite.config.ts",
      "config/**",
      "turbo.json",
      "lint-staged.config.mjs",
      "commitlint.config.mjs"
    ],
    "editorialAgent": "editorial-reviewer",
    "editorialWhenAny": ["**"]
  }
}
